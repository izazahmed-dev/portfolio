# documents cabinet: the originals and their previews are no longer public
# assets. They live in /secured and are streamed by the server through the
# /doc and /preview routes, so they must never land in a build artefact, a
# CDN cache, or a public repository mirror.
/secured

# retired site versions: 751 files, ~26MB of dead frames and a superseded
# component tree. Kept on disk, deliberately out of history.
_archive

# secret that signs document URLs. Never commit a real one.
/.env
/.env*.local

