# Secrets for document link signing.
#
# Copy to .env.local (git-ignored) and fill in a real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# MUST be at least 32 characters. In production protected requests return 503
# without it; the app never falls back to a known default secret.
#
# Rotating this invalidates every previously issued link, which is the
# emergency revocation lever if a document link ever leaks in public.
DOC_SIGNING_SECRET=

# Required in production. Point this at a private mounted directory or a
# deployment-specific private volume; never point it at a public repository
# checkout or a static/public directory. Local development may omit it and use
# the ignored ./secured folder.
# SECURED_DIR=/private/portfolio-evidence

# Optional S3-compatible private storage. In production configure these
# instead of SECURED_DIR when deploying on Vercel. The bucket must be private;
# the app reads objects server-side and never exposes public object URLs.
# S3_BUCKET=portfolio-private-evidence
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PREFIX=portfolio
# S3_FORCE_PATH_STYLE=false

# Required in multi-instance production. Local development falls back to the
# in-process limiter when these are omitted.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
