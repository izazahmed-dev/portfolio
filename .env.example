# Secrets for document link signing.
#
# Copy to .env.local (git-ignored) and fill in a real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# MUST be at least 32 characters. In production the app refuses to boot
# without it, deliberately: a known default secret would let anyone mint a
# valid link to any document, which defeats the entire scheme.
#
# Rotating this invalidates every previously issued link, which is the
# emergency revocation lever if a document link ever leaks in public.
DOC_SIGNING_SECRET=

# Optional. Where the private document tree lives, relative to the app root.
# Defaults to "secured", which is also the .gitignore entry.
# SECURED_DIR=secured
